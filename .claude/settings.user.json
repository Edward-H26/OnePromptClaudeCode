      "Bash(git add:*)",
      "Bash(git fetch:*)",
      "Bash(git remote:*)",
      "Bash(git show:*)",
      "Bash(git blame:*)",
      "Bash(git rev-parse:*)",
      "Bash(git tag:*)",
      "Bash(git worktree:*)",
      "Bash(git ls-files:*)",
      "Bash(git ls-tree:*)",
      "Bash(git stash:*)",
      "Bash(git checkout:*)",
      "Bash(git config:*)",
      "Bash(git rm:*)",
      "Bash(git clean:*)",
      "Bash(cp:*)",
      "Bash(mv:*)",
      "Bash(mkdir:*)",
      "Bash(zip:*)",
      "Bash(unzip:*)",
      "Bash(curl:*)",
      "Bash(bundle exec:*)",
      "Bash(streamlit:*)",
      "Bash(sqlite3:*)",
      "Bash(iconv:*)",
