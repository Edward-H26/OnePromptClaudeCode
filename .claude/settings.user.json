      "Bash(file:*)",
      "Bash(touch:*)",
      "Bash(date:*)",
      "Bash(pwd:*)",
      "Bash(tee:*)",
      "Bash(tr:*)",
      "Bash(xargs:*)",
      "Bash(basename:*)",
      "Bash(dirname:*)",
      "Bash(mktemp:*)",
      "Bash(sleep:*)",
      "Bash(nohup:*)",
      "Bash(open:*)",
      "Bash(env:*)",
      "Bash(source:*)",
      "Bash(command:*)",
      "Bash(type:*)",
      "Bash(bash:*)",
      "Bash(sh:*)",
      "Bash(rm:*)",
      "Bash(chmod:*)",
      "Bash(gh:*)",
