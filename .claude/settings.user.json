      "Read(./.env.*)",
      "Read(./.claude.json)",
      "Read(./.claude/settings.local.json)",
      "Read(./settings.json)",
      "Read(./history.jsonl)",
      "Read(./mcp-needs-auth-cache.json)",
      "Read(./backups/**)",
      "Read(./file-history/**)",
      "Read(./session-env/**)",
      "Read(./sessions/**)",
      "Read(./.claude/runtime/**)",
      "Read(./.credentials.json)",
      "Bash(cat .env*)",
      "Bash(cat .credentials*)",
      "Bash(cat **/auth.json)",
      "mcp__github__add_comment_to_pending_review",
      "mcp__github__add_issue_comment",
      "mcp__github__add_reply_to_pull_request_comment",
      "mcp__github__create_branch",
      "mcp__github__create_or_update_file",
      "mcp__github__create_pull_request",
      "mcp__github__create_repository",
      "mcp__github__delete_file",
      "mcp__github__delete_repository",
      "mcp__github__fork_repository",
      "mcp__github__issue_write",
      "mcp__github__merge_pull_request",
      "mcp__github__pull_request_review_write",
      "mcp__github__push_files",
      "mcp__github__request_copilot_review",
      "mcp__github__run_secret_scanning",
      "mcp__github__sub_issue_write",
      "mcp__github__update_issue_comment",
      "mcp__github__update_pull_request",
      "mcp__github__update_pull_request_branch"
    ],
    "ask": [
      "Bash(git merge:*)",
      "Bash(git rebase:*)"
    ],
    "defaultMode": "auto"
  },
  "model": "claude-opus-5-5",
  "enableAllProjectMcpServers": false,
  "skillOverrides": {
    "academic-paper": "name-only",
    "academic-paper-reviewer": "name-only",
    "academic-pipeline": "name-only",
    "ccf-common": "name-only",
    "ccf-experiment-designer": "name-only",
    "ccf-humanization": "name-only",
    "ccf-idea-optimizer": "name-only",
    "ccf-idea-reviewer": "name-only",
    "ccf-integrity-auditor": "name-only",
    "ccf-literature-monitor": "name-only",
    "ccf-literature-searcher": "name-only",
    "ccf-paper-reviewer": "name-only",
    "ccf-paper-to-exemplar": "name-only",
    "ccf-paper-writer": "name-only",
    "ccf-pipeline-orchestrator": "name-only",
    "ccf-project-scaffolder": "name-only",
    "ccf-rebuttal-writer": "name-only",
    "ccf-skill-forger": "name-only",
    "ccf-submission-checker": "name-only",
    "ccf-visual-composer": "name-only",
    "citation-check-skill": "name-only",
    "deep-research": "name-only",
    "nature-academic-search": "name-only",
    "nature-citation": "name-only",
    "nature-polishing": "name-only",
    "office-academic-skill": "name-only",
    "paper-spine": "name-only",
    "paper-spine-audit": "name-only",
    "paper-spine-build": "name-only",
    "paper-spine-citation": "name-only",
    "paper-spine-humanize": "name-only",
    "paper-spine-intake": "name-only",
    "paper-spine-latex": "name-only",
    "paper-spine-research": "name-only",
    "paper-spine-rewrite": "name-only",
    "paper-spine-translate": "name-only",
    "paper-spine-ui": "name-only",
    "paper-spine-update": "name-only",
    "research-paper-writing": "name-only",
    "research-writing-skill": "name-only",
    "scientific-figure-making": "name-only",
    "scientific-toolkit-skill": "name-only",
    "update-config": "user-invocable-only",
    "claude-api": "user-invocable-only"
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|MultiEdit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/post-tool-use-tracker.sh"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/workflow-step-tracker.sh"
          }
        ]
      },
      {
        "matcher": "Skill",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/workflow-step-tracker.sh"
          }
        ]
      },
      {
        "matcher": "mcp__claude-in-chrome__*|mcp__plugin_playwright_playwright__*|mcp__playwright__*",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/workflow-step-tracker.sh"
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "[ -x \"${CLAUDE_PROJECT_DIR:-$PWD}/.claude/hooks/compact-keep.sh\" ] || $HOME/.claude/hooks/compact-keep.sh",
            "timeout": 10
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "compact",
        "hooks": [
          {
            "type": "command",
            "command": "[ -x \"${CLAUDE_PROJECT_DIR:-$PWD}/.claude/hooks/compact-restore.sh\" ] || $HOME/.claude/hooks/compact-restore.sh",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/stop-build-check-enhanced.sh"
          }
        ]
      }
    ]
  },
  "worktree": {
    "baseRef": "fresh"
  },
  "statusLine": {
    "type": "command",
    "command": "bash $HOME/.claude/statusline.sh"
  },
  "enabledPlugins": {
    "pyright-lsp@claude-plugins-official": true,
    "typescript-lsp@claude-plugins-official": true,
    "frontend-design@claude-plugins-official": true,
    "feature-dev@claude-plugins-official": true,
    "superpowers@claude-plugins-official": false,
    "code-review@claude-plugins-official": true,
    "code-simplifier@claude-plugins-official": true,
    "huggingface-skills@claude-plugins-official": false,
    "context7@claude-plugins-official": true,
    "figma@claude-plugins-official": false,
    "github@claude-plugins-official": false,
    "playwright@claude-plugins-official": true,
    "chrome-devtools-mcp@claude-plugins-official": true,
    "security-guidance@claude-plugins-official": false,
    "greptile@claude-plugins-official": false,
    "progress-ledger@edward-mods": false,
    "cc-plugin-you-should-know@builtin": true,
    "show-your-work@iamumeransari": true,
    "clangd-lsp@claude-plugins-official": true
  },
  "extraKnownMarketplaces": {
    "edward-mods": {
      "source": {
        "source": "directory",
        "path": "/Users/edwardhu/Desktop/agent/claude/mods"
      }
    },
    "iamumeransari": {
      "source": {
        "source": "git",
        "url": "https://github.com/iamumeransari/claude-show-your-work.git",
        "ref": "releases"
      }
    }
  },
  "outputStyle": "Essentials",
  "feedbackDrafts": "notify",
  "modelSettings": {
    "claude-opus-5-5": {
      "effortLevel": "xhigh"
    },
    "claude-sonnet-5-5": {
      "effortLevel": "xhigh"
    },
    "claude-haiku-5-5": {
      "effortLevel": "high"
    },
    "claude-fable-5-2": {
      "effortLevel": "xhigh"
    },
    "claude-fable-5-1": {
      "effortLevel": "xhigh"
    }
  },
  "autoCompactWindow": 400000,
  "advisorModel": "fable",
  "promptSuggestionEnabled": false,
  "askUserQuestionTimeout": "never",
  "plansDirectory": "./plans",
  "tui": "fullscreen",
  "showThinkingSummaries": true,
  "skipWorkflowUsageWarning": true,
  "verbose": false,
  "switchModelsOnFlag": false,
  "autoContinueAtUsageLimit": true,
  "autoScrollEnabled": true,
  "terminalProgressBarEnabled": true,
  "teammateMode": "auto",
  "remoteControlAtStartup": true,
  "agentPushNotifEnabled": false,
  "skipAutoPermissionPrompt": true,
  "autoMode": {
    "environment": [
      "**Projects**: the user works in many projects under ~/Desktop (courses, research code, the Claude config repo at ~/Desktop/agent/claude); the current working directory names the project of the session.",
      "**Trusted remotes**: repositories under github.com/Edward-H26 and their upstreams; the user alone commits and pushes.",
      "**Out of scope without the user**: deleting data outside the project folder, writing credentials anywhere, sending project data to a service the user did not name.",
      "**Secrets**: .env files, API keys and passwords stay out of every repository and every message."
    ]
  }
}
