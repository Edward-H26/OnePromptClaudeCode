      "mcp__playwright",
      "mcp__context7",
      "mcp__github",
      "mcp__plugin_figma_figma",
      "mcp__plugin_chrome-devtools-mcp_chrome-devtools",
      "mcp__remotion-docs",
      "mcp__remotion-app",
      "Edit",
      "Write",
      "MultiEdit",
      "NotebookEdit",
      "Bash(ssh js2:*)",
